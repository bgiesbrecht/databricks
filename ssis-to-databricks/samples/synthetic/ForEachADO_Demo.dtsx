<?xml version="1.0"?>
<DTS:Executable xmlns:DTS="www.microsoft.com/SqlServer/Dts"
  DTS:ObjectName="ForEachADO_Demo"
  DTS:CreationName="Microsoft.Package"
  DTS:ExecutableType="Microsoft.Package">
  <DTS:Variables>
    <DTS:Variable DTS:ObjectName="rsCustomers" DTS:Namespace="User">
      <DTS:VariableValue DTS:DataType="9" />
    </DTS:Variable>
    <DTS:Variable DTS:ObjectName="CustomerID" DTS:Namespace="User">
      <DTS:VariableValue DTS:DataType="3">0</DTS:VariableValue>
    </DTS:Variable>
    <DTS:Variable DTS:ObjectName="CustomerName" DTS:Namespace="User">
      <DTS:VariableValue DTS:DataType="8" />
    </DTS:Variable>
  </DTS:Variables>
  <DTS:ConnectionManagers>
    <DTS:ConnectionManager DTS:ObjectName="localhost.SalesDB" DTS:CreationName="OLEDB">
      <DTS:ObjectData>
        <DTS:ConnectionManager DTS:ConnectionString="Data Source=localhost;Initial Catalog=SalesDB;Provider=SQLNCLI11.1;Integrated Security=SSPI;" />
      </DTS:ObjectData>
    </DTS:ConnectionManager>
  </DTS:ConnectionManagers>
  <DTS:Executables>
    <DTS:Executable DTS:ObjectName="Foreach Customer Row" DTS:CreationName="STOCK:FOREACHLOOP"
      DTS:ExecutableType="STOCK:FOREACHLOOP">
      <DTS:ForEachEnumerator DTS:CreationName="Microsoft.ForEachADOEnumerator"
        DTS:ObjectName="{ADOEnum}">
        <DTS:ObjectData>
          <ForEachADOEnumeratorProperties>
            <FEADOProperty VariableName="User::rsCustomers" />
            <FEADOProperty EnumerationType="0" />
          </ForEachADOEnumeratorProperties>
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:ForEachVariableMappings>
        <DTS:ForEachVariableMapping DTS:VariableName="User::CustomerID" DTS:ValueIndex="0"
          DTS:ObjectName="{map0}" />
        <DTS:ForEachVariableMapping DTS:VariableName="User::CustomerName" DTS:ValueIndex="1"
          DTS:ObjectName="{map1}" />
      </DTS:ForEachVariableMappings>
      <DTS:Executables>
        <DTS:Executable DTS:ObjectName="Upsert Customer" DTS:CreationName="Microsoft.Pipeline"
          DTS:ExecutableType="Microsoft.Pipeline">
          <DTS:ObjectData>
            <pipeline>
              <components>
                <component refId="Package\Foreach Customer Row\Upsert Customer\Row Source"
                  name="Row Source" componentClassID="Microsoft.OLEDBSource">
                  <properties>
                    <property name="SqlCommand">select ? AS CustomerID, ? AS CustomerName</property>
                    <property name="AccessMode">2</property>
                  </properties>
                  <outputs>
                    <output name="OLE DB Source Output">
                      <outputColumns>
                        <outputColumn name="CustomerID" dataType="i4" />
                        <outputColumn name="CustomerName" dataType="wstr" length="100" />
                      </outputColumns>
                    </output>
                  </outputs>
                </component>
                <component refId="Package\Foreach Customer Row\Upsert Customer\Dim Destination"
                  name="Dim Destination" componentClassID="Microsoft.OLEDBDestination">
                  <properties>
                    <property name="OpenRowset">[dbo].[DimCustomer]</property>
                    <property name="AccessMode">3</property>
                  </properties>
                </component>
              </components>
              <paths>
                <path name="p1"
                  startId="Package\Foreach Customer Row\Upsert Customer\Row Source.Outputs[OLE DB Source Output]"
                  endId="Package\Foreach Customer Row\Upsert Customer\Dim Destination.Inputs[OLE DB Destination Input]" />
              </paths>
            </pipeline>
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
    </DTS:Executable>
  </DTS:Executables>
</DTS:Executable>
